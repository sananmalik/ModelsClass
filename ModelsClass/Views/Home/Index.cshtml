@{
    ViewData["Title"] = "Home Page";
    var students = ViewData["_students"] as List<ModelClass>;
}

<div class="text-center">
    <h1 class="display-4">Welcome</h1>
    <p>Learn about <a href="https://learn.microsoft.com/aspnet/core">building Web apps with ASP.NET Core</a>.</p>
</div>


@{
    foreach (var std in students)
    {
        <div>
            <h2>@std.Name</h2>
            <p>Degree: @std.Degree</p>
            <p>University: @std.University</p>
            <p>Graduation Year: @std.GraduationYear</p>
            <p>Graduation Month: @std.GraduationMonth</p>
        </div>
    }
}